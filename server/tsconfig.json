{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "declaration": false,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  // `api/` é a entrada serverless (Vercel). Fica fora do tsconfig.build.json —
  // quem compila aquela função é a própria plataforma — mas precisa ser
  // verificada aqui, senão um erro de tipo na entrada só aparece no deploy.
  "include": ["src/**/*.ts", "tests/**/*.ts", "api/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
