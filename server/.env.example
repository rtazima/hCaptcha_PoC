# ---------------------------------------------------------------------------
# Backend da PoC — copie para .env e ajuste
# ---------------------------------------------------------------------------

PORT=8787
HOST=0.0.0.0
CORS_ORIGIN=*

# ---------------------------------------------------------------------------
# Persistência
# ---------------------------------------------------------------------------
# Sem DATABASE_URL: arquivo JSON (inspecionável, zero dependência externa).
# Caminho do arquivo, ou "memory" para não persistir nada.
DATA_FILE=data/db.json

# Com DATABASE_URL: Postgres. As migrações são aplicadas no boot e a chave de
# cifra é conferida contra os dados já gravados — chave errada não sobe.
# Há um docker-compose.yml na raiz para quem não tem Postgres local (porta 5433).
# Para migrar sem subir o servidor (pipeline de deploy): npm run db:migrate
# DATABASE_URL=postgres://hcaptcha_poc:poc_local_dev@127.0.0.1:5433/hcaptcha_poc

# ---------------------------------------------------------------------------
# hCaptcha
# ---------------------------------------------------------------------------
# Modos:
#   test  -> chaves PÚBLICAS de teste do hCaptcha. Nunca desafiam, sempre passam
#            e NÃO devolvem score. Serve para validar o encanamento, não o risco.
#   live  -> suas chaves reais. Com sitekey Enterprise Passive/Invisible o
#            /siteverify devolve `score` (risco) e `score_reason`.
#   mock  -> sem rede. O token carrega o risco: "mock:0.85", "mock:fail".
#            Usado pelos testes e pelo simulador. NUNCA use em produção.
HCAPTCHA_MODE=test

# Par público de teste do hCaptcha (o default do código, repetido aqui só para
# ficar explícito). Para biometria comportamental de verdade você precisa de um
# sitekey Enterprise configurado como Passive + Invisible.
HCAPTCHA_SITEKEY=10000000-ffff-ffff-ffff-000000000001
HCAPTCHA_SECRET=0x0000000000000000000000000000000000000000

HCAPTCHA_VERIFY_URL=https://api.hcaptcha.com/siteverify
HCAPTCHA_TIMEOUT_MS=8000

# rqdata (Enterprise): payload assinado que amarra o token à sessão.
# O backend repassa isto para o app em GET /v1/config e POST /v1/sessions/init.
# HCAPTCHA_RQDATA=

# Uso único do token. Default: ligado só em modo live — as chaves de teste
# devolvem sempre o MESMO token, e o antirreplay bloquearia o desenvolvimento.
# HCAPTCHA_ENFORCE_SINGLE_USE=false

# Risco assumido quando o sitekey não é Enterprise (resposta sem `score`).
HCAPTCHA_DERIVED_RISK_PASS=0.15
HCAPTCHA_DERIVED_RISK_FAIL=0.9
# risco devolvido no modo mock quando o token não especifica um
HCAPTCHA_MOCK_RISK=0.1

# ---------------------------------------------------------------------------
# Cadastro
# ---------------------------------------------------------------------------
ENROLL_SAMPLES_REQUIRED=5
ENROLL_MAX_SAMPLES=20
# reforça o template com verificações claramente genuínas (cuidado: abre porta
# para envenenamento gradual do template)
ENROLL_ADAPT_ON_ALLOW=false

# ---------------------------------------------------------------------------
# Calibração do matcher
# ---------------------------------------------------------------------------
# Distância que corresponde a similaridade 0.5 e a inclinação da logística.
# Os defaults saíram do simulador com dados sintéticos: RECALIBRE com o corpus
# real antes de tirar qualquer conclusão de acurácia (`npm run simulate` imprime
# a sugestão a cada execução).
MATCH_MIDPOINT=1.19
MATCH_STEEPNESS=0.215
MATCH_SHRINKAGE=3

# ---------------------------------------------------------------------------
# Política de decisão
# ---------------------------------------------------------------------------
POLICY_THRESHOLD=0.6
POLICY_STEP_UP_BAND=0.12
# margem mínima entre 1º e 2º colocado no 1:N
POLICY_IDENTIFY_MARGIN=0.05
# acréscimo no limiar para busca 1:N (identificar é mais difícil que verificar)
POLICY_IDENTIFY_BOOST=0.15
# em risco alto, o melhor resultado possível é step-up (nunca allow direto)
POLICY_HIGH_RISK_STEP_UP=true

SESSION_TTL_MS=600000

# ---------------------------------------------------------------------------
# Segurança
# ---------------------------------------------------------------------------
# Chaves de API aceitas, separadas por vírgula (mínimo 16 caracteres cada).
# Sem isto a API sobe ABERTA e avisa no boot — qualquer um na mesma rede
# cadastra, verifica e lista pessoas. Aceite isso só em laboratório.
#   openssl rand -hex 24
# Aceitar mais de uma permite rotação sem downtime.
# API_KEYS=

# Cifra dos campos biométricos em repouso (AES-256-GCM). 32 bytes em base64
# ou hex. Sem isto os templates ficam EM CLARO no arquivo de dados.
# Dado biométrico é sensível na LGPD e, ao contrário de senha, não se "reseta":
# vazou o jeito de digitar, vazou para sempre.
#   openssl rand -base64 32
# A estrutura do arquivo segue legível (quem existe, auditoria); apenas vetores
# e templates são cifrados. Perder a chave = perder os cadastros.
# TEMPLATE_ENCRYPTION_KEY=
